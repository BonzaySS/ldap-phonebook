# ldap-phonebook — web UI configuration
#
# This file is read by systemd (EnvironmentFile=) and passed to app.py.
# After editing, run:  systemctl restart ldap-phonebook

# --- HTTP server ---
PB_HOST=0.0.0.0
PB_PORT=8500
# text in the page header (PB_SUBTITLE may be empty)
PB_TITLE=Телефонная книга
PB_SUBTITLE=

# --- LDAP connection ---
PB_LDAP_HOST=127.0.0.1
PB_LDAP_PORT=389
PB_BASE_DN=dc=example,dc=org
PB_PEOPLE_DN=ou=people,dc=example,dc=org
# how a login name turns into a bind DN: "admin" -> cn=admin,dc=example,dc=org
PB_BIND_PATTERN=cn=%s,dc=example,dc=org

# --- sessions ---
# how long a login stays valid, in seconds (12 hours)
PB_SESSION_TTL=43200
